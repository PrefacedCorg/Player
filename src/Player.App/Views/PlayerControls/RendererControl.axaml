<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Player.App.ViewModels"
             x:Class="Player.App.Views.PlayerControls.RendererControl"
             x:DataType="vm:MainWindowViewModel">

  <!-- 只绑 VM.Renderer：真正切换渲染视图（重建 mpv 上下文、同步触摸层）由主窗口监听 VM 变化后处理 -->
  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <TextBlock Text="渲染器" Foreground="#A8A8B0" FontSize="20" VerticalAlignment="Center" />
    <ComboBox ItemsSource="{Binding RendererOptions}"
              SelectedItem="{Binding Renderer}"
              VerticalAlignment="Center" />
  </StackPanel>
</UserControl>