<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Player.App.ViewModels"
             x:Class="Player.App.Views.PlayerControls.LoopModeControl"
             x:DataType="vm:MainWindowViewModel">

  <Button Content="{Binding LoopModeText}"
          Command="{Binding CycleLoopModeCommand}"
          Foreground="{DynamicResource PlayerControlForeground}" />
</UserControl>
