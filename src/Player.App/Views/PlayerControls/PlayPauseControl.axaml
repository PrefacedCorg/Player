<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Player.App.ViewModels"
             x:Class="Player.App.Views.PlayerControls.PlayPauseControl"
             x:DataType="vm:MainWindowViewModel">

  <Button Content="{Binding PlayPauseText}" Command="{Binding TogglePauseCommand}" />
</UserControl>