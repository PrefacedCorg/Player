<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Player.App.ViewModels"
        xmlns:pc="clr-namespace:Player.App.Views.PlayerControls"
        xmlns:mpv="clr-namespace:HanumanInstitute.LibMpv.Avalonia;assembly=HanumanInstitute.LibMpv.Avalonia"
        x:Class="Player.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Player · M0 骨架"
        Width="1280"
        Height="800"
        Background="#0F0F13">

  <!-- 布局前提：默认 Native 渲染器下视频是原生子窗口，Avalonia 控件无法叠加在视频之上，
       因此信息与控制一律放在视频区之外的控制条里。
       控件尺寸不再逐控件覆盖，一律走 FluentAvaloniaTheme 的默认度量。 -->
  <Grid RowDefinitions="*,Auto">

    <mpv:MpvView x:Name="VideoView"
                 Grid.Row="0"
                 Renderer="Native"
                 MpvContext="{Binding Mpv}" />

    <Border Grid.Row="1" Background="#1B1B22" IsVisible="{Binding IsControlBarVisible}">
      <Grid RowDefinitions="Auto,Auto,Auto">

        <!-- 控制行：控件全部组件化（Views/PlayerControls 下一个控件一个文件），
             这里只放宿主，具体放哪些控件、按什么顺序由设置里的有序列表决定，
             可在 设置 → 控制栏 里勾选显隐与调整顺序，改完立即重建。 -->
        <pc:PlayerControlBar Grid.Row="0" />

        <!-- 状态与起播时序 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20">
          <TextBlock Text="{Binding StatusText}" Foreground="#F0F0F0" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TimingText}" Foreground="#7CF7B0" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding MediaTitle}" Foreground="#A8A8B0" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 解码 / CPU 诊断 -->
        <TextBlock Grid.Row="2" Text="{Binding DebugText}" Foreground="#B9C0FF" FontSize="13" />
      </Grid>
    </Border>
  </Grid>
</Window>