<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Player.App.ViewModels"
             xmlns:views="clr-namespace:Player.App.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="32"
             x:Class="Player.App.Views.PlayerControls.PositionControl"
             x:DataType="vm:MainWindowViewModel">

  <!-- 自绘进度条：填充/拇指边界吸附整像素，杜绝灰色剩余段的亚像素抖动。
       左右两侧的时间由「组件设置」驱动（显示模式 + h:m:s:ms 精度，见 code-behind）。
       拖动开始/结束在代码后置里转给 ViewModel（拖动期间忽略引擎回写，松手才 seek）。 -->
  <Grid ColumnDefinitions="Auto,*,Auto">
    <TextBlock x:Name="LeftTime"
               Grid.Column="0"
               Margin="10 0 6 0"
               TextAlignment="Right"
               VerticalAlignment="Center"
               Foreground="{DynamicResource PlayerControlForeground}"
               FontSize="{DynamicResource PlayerControlBodyFontSize}" />

    <views:PositionBar x:Name="Bar"
                       Grid.Column="1"
                       Minimum="0"
                       Maximum="{Binding DurationSeconds}"
                       Value="{Binding PositionSeconds, Mode=TwoWay}"
                       VerticalAlignment="Center" />

    <TextBlock x:Name="RightTime"
               Grid.Column="2"
               Margin="6 0 10 0"
               TextAlignment="Left"
               VerticalAlignment="Center"
               Foreground="{DynamicResource PlayerControlForeground}"
               FontSize="{DynamicResource PlayerControlBodyFontSize}" />
  </Grid>
</UserControl>
