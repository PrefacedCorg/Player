<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:Player.App.ViewModels"
             x:Class="Player.App.Views.SettingsPages.GestureSettingsPage"
             x:DataType="vm:GestureSettingsViewModel">

  <!-- 画面手势的设置：单击 / 双击各选一个离散操作，三类滑动各选一个连续调节项。
       绑的是共享设置上的包装属性（Gestures.XXXOption），主窗口执行手势时现读同一份设置，
       所以这里改完立即生效；选「不执行 / 不调节」则该手势什么都不做。 -->
  <StackPanel Spacing="12">
    <StackPanel Spacing="4" Margin="0,0,0,8">
      <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="#F0F0F0" />
      <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#A8A8B0" />
    </StackPanel>

    <ui:FASettingsExpander Header="单击"
                           Description="轻点画面一次（按下到抬起的位移小于 8 像素）">
      <ui:FASettingsExpander.Footer>
        <ComboBox ItemsSource="{Binding ActionOptions}"
                  SelectedItem="{Binding Gestures.TapActionOption, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander Header="双击"
                           Description="300 毫秒内在画面同一位置连点两次">
      <ui:FASettingsExpander.Footer>
        <ComboBox ItemsSource="{Binding ActionOptions}"
                  SelectedItem="{Binding Gestures.DoubleTapActionOption, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander Header="左右滑动"
                           Description="三种调节都能配：进度沿滑动方向 4 像素 = 1 秒（与视频区大小、时长无关），音量 / 亮度滑满视频区宽 = 100 个单位；向右为加大">
      <ui:FASettingsExpander.Footer>
        <ComboBox ItemsSource="{Binding AdjustOptions}"
                  SelectedItem="{Binding Gestures.HorizontalSwipeAdjustOption, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander Header="拖动时画面跟随"
                           Description="任意手势配成「调整进度」时，拖动过程中画面都实时跟随手指（暂停预览目标位置，抬手后恢复原来的播放 / 暂停状态）">
      <ui:FASettingsExpander.Footer>
        <ToggleSwitch IsChecked="{Binding Gestures.LiveSeekWhileSwiping, Mode=TwoWay}" OnContent="开" OffContent="关" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander Header="左半区上下滑动"
                           Description="三种调节都能配：往上滑为加大，进度 4 像素 = 1 秒，音量 / 亮度滑满视频区高 = 100 个单位">
      <ui:FASettingsExpander.Footer>
        <ComboBox ItemsSource="{Binding AdjustOptions}"
                  SelectedItem="{Binding Gestures.LeftVerticalSwipeAdjustOption, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander Header="右半区上下滑动"
                           Description="三种调节都能配：往上滑为加大，进度 4 像素 = 1 秒，音量 / 亮度滑满视频区高 = 100 个单位">
      <ui:FASettingsExpander.Footer>
        <ComboBox ItemsSource="{Binding AdjustOptions}"
                  SelectedItem="{Binding Gestures.RightVerticalSwipeAdjustOption, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <TextBlock Margin="0,4,0,0"
               FontSize="12"
               Foreground="#8A8A92"
               TextWrapping="Wrap"
               Text="手势在视频区触摸层上判定，只在 Native 渲染器下生效（OpenGl 渲染器下视频位于界面内，由界面直接接收触摸）。画面缩放方式为「原始大小」「自由缩放」时，拖动用于平移画面，滑动调节不生效。斜着滑也可以：移动的主方向一明确就锁定该轴，之后整次拖动只做这一种调节。" />
  </StackPanel>
</UserControl>