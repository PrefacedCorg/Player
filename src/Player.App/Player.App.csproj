<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Player.Playback\Player.Playback.csproj" />
    <ProjectReference Include="..\Player.Library\Player.Library.csproj" />
    <ProjectReference Include="..\Player.Platform\Player.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- libmpv 原生库不随 NuGet 包分发，需自行下载：scripts/fetch-libmpv.ps1 -->
    <None Include="..\..\third_party\mpv\win-x64\libmpv-2.dll"
          Link="libmpv-2.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\third_party\mpv\win-x64\libmpv-2.dll')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <!-- WinUI 风格控件（FANavigationView / FASettingsExpander 等）。
         包 ID 是 FluentAvaloniaUI；3.x 起对应 Avalonia 12（此处 3.1.0 依赖 Avalonia 12.1.0）。 -->
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HanumanInstitute.LibMpv" Version="0.10.1" />
    <PackageReference Include="HanumanInstitute.LibMpv.Avalonia" Version="0.10.1" />
    <!-- 拖动排序：ManagedContextDragBehavior（托管拖动 + 浮动预览）与 ManagedContextDropBehavior（落点处理）。
         ClassIsland 的组件拖动用的就是这套（沿用 avalonia 官方的 Xaml.Behaviors 包）。 -->
    <PackageReference Include="Xaml.Behaviors" Version="12.0.7" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

</Project>