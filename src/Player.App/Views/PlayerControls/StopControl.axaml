<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Player.App.ViewModels"
             xmlns:controls="clr-namespace:Player.App.Controls"
             x:Class="Player.App.Views.PlayerControls.StopControl"
             x:DataType="vm:MainWindowViewModel">

  <controls:PlayerControlButton Text="停止" Icon="{x:Static controls:PlayerControlIcons.Stop}" Command="{Binding StopCommand}"
                                Foreground="{DynamicResource PlayerControlForeground}" />
</UserControl>
