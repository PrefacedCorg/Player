<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Player.App.Views.PositionBar"
             MinHeight="32"
             Background="Transparent"
             ClipToBounds="False">

  <!-- 自绘进度条。轨道/填充/拇指的位置全部在代码后置取整到整像素（见 PositionBar.axaml.cs），
       避免 Slider 内部 Track 把灰色剩余段边界放在亚像素位置、随播放推进反复抗锯齿（肉眼即抖动）。
       拇指直接复用 FluentAvalonia 的 SliderThumbStyle，观感与原 Slider 完全一致。
       轨道两端各缩进 ThumbSize/2（9px），给 Thumb 留出绘制缓冲，最左最右时圆圈不被控件边缘挡住。 -->
  <Grid x:Name="Root" ClipToBounds="False">
    <!-- 灰色剩余轨道：两端各缩进 TrackPadding=9px，给 Thumb 留出绘制缓冲 -->
    <Border Height="{DynamicResource SliderTrackThemeHeight}"
            CornerRadius="{DynamicResource SliderTrackCornerRadius}"
            VerticalAlignment="Center"
            Margin="9,0"
            Background="{DynamicResource SliderTrackFill}" />

    <Border x:Name="FillPart"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Width="0"
            Height="{DynamicResource SliderTrackThemeHeight}"
            CornerRadius="{DynamicResource SliderTrackCornerRadius}"
            Margin="9,0,0,0"
            Background="{DynamicResource SliderTrackValueFill}" />

    <!-- Thumb 在 Canvas 上自由定位，ClipToBounds=False 允许它溢出 Root 边缘也能完整绘制 -->
    <Canvas ClipToBounds="False">
      <Thumb x:Name="ThumbPart"
             Theme="{StaticResource SliderThumbStyle}"
             Width="18"
             Height="18" />
    </Canvas>
  </Grid>
</UserControl>
