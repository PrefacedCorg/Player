<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Player.App.Views.PlayerControls.RewindControl">

  <!-- 跳转秒数在「组件设置」里配置（快进/回退共用一个设置页），点击时按各自配置跳 -->
  <Button Content="回退" Click="OnClick" Foreground="{DynamicResource PlayerControlForeground}" />
</UserControl>
