<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:Player.App.Views.SettingsPages"
             xmlns:controlSettings="clr-namespace:Player.App.Views.SettingsPages.ControlSettings"
             xmlns:app="clr-namespace:Player.App"
             xmlns:controls="clr-namespace:Player.App.Controls"
             xmlns:behaviors="clr-namespace:Player.App.Behaviors"
             xmlns:vm="clr-namespace:Player.App.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:ia="using:Avalonia.Xaml.Interactivity"
             xmlns:dnd="using:Avalonia.Xaml.Interactions.DragAndDrop"
             x:Class="Player.App.Views.SettingsPages.ControlBarSettingsPage"
             x:DataType="vm:ControlBarSettingsViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox.drag-source ListBoxItem">
            <Setter Property="(ia:Interaction.Behaviors)">
                <ia:BehaviorCollectionTemplate>
                    <ia:BehaviorCollection>
                        <behaviors:AdvancedManagedContextDragBehavior HorizontalDragThreshold="3" VerticalDragThreshold="3"/>
                    </ia:BehaviorCollection>
                </ia:BehaviorCollectionTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.component-listBox">
            <Style.Resources>
                <MenuFlyout x:Key="ComponentsOperationMenuFlyout">
                    <MenuItem Header="向左移动一位"
                              Command="{Binding $parent[pages:ControlBarSettingsPage].MovePreviousCommand}"
                              CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <ui:FASymbolIcon Symbol="Back" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="向右移动一位"
                              Command="{Binding $parent[pages:ControlBarSettingsPage].MoveNextCommand}"
                              CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <ui:FASymbolIcon Symbol="Forward" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="包裹到新容器"
                              ItemsSource="{Binding $parent[pages:ControlBarSettingsPage].ViewModel.Containers}">
                        <MenuItem.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                          x:CompileBindings="False">
                                <Setter Property="Header" Value="{Binding Title}"/>
                                <Setter Property="Icon">
                                    <Template>
                                        <ui:FASymbolIcon Symbol="{Binding Symbol}" FontSize="14"/>
                                    </Template>
                                </Setter>
                                <Setter Property="Command"
                                        Value="{Binding $parent[pages:ControlBarSettingsPage].CreateContainerComponentCommand}"/>
                                <Setter Property="CommandParameter" Value="{Binding}"/>
                            </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <MenuItem Header="移动到选中的容器"
                              IsEnabled="{Binding $parent[pages:ControlBarSettingsPage].ViewModel.IsComponentChildrenViewOpen}"
                              Command="{Binding $parent[pages:ControlBarSettingsPage].MoveToCurrentContainerCommand}"
                              CommandParameter="{Binding}"/>
                    <MenuItem Header="从容器组件移出"
                              IsEnabled="{Binding $parent[pages:ControlBarSettingsPage].ViewModel.IsComponentChildrenViewOpen}"
                              Command="{Binding $parent[pages:ControlBarSettingsPage].MoveComponentsToMainLinesCommand}"
                              CommandParameter="{Binding}"/>
                    <Separator/>
                    <MenuItem Header="创建副本"
                              Command="{Binding $parent[pages:ControlBarSettingsPage].DuplicateCommand}"
                              CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <ui:FASymbolIcon Symbol="Copy" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuFlyout>
            </Style.Resources>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="ItemTemplate">
                <DataTemplate DataType="app:PlayerControlItem">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <controls:TouchDragThumb Margin="-4 0 -2 0" IsCompact="True"/>
                        <ui:FAIconSourceElement IconSource="{Binding IconSource}"
                                                VerticalAlignment="Center" Height="14" Width="14"
                                                ClipToBounds="False"/>
                        <TextBlock Text="{Binding Title}"
                                   VerticalAlignment="Center"/>
                        <Button VerticalAlignment="Center"
                                ToolTip.Tip="更多选项…"
                                Flyout="{StaticResource ComponentsOperationMenuFlyout}"
                                Background="Transparent"
                                BorderThickness="0"
                                IsVisible="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}">
                            <ui:FASymbolIcon Symbol="More" FontSize="14"/>
                        </Button>
                        <Button VerticalAlignment="Center"
                                ToolTip.Tip="查看子组件"
                                Click="ButtonShowChildrenComponents_OnClick"
                                Background="Transparent"
                                BorderThickness="0">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}" x:CompileBindings="False">
                                    <Binding Path="IsSelected"
                                             RelativeSource="{RelativeSource FindAncestor, AncestorType=ListBoxItem}"/>
                                    <Binding Path="IsContainer"/>
                                </MultiBinding>
                            </Button.IsVisible>
                            <ui:FASymbolIcon Symbol="Forward" FontSize="14"/>
                        </Button>
                        <Button Foreground="IndianRed"
                                VerticalAlignment="Center"
                                ToolTip.Tip="删除"
                                Background="Transparent"
                                BorderThickness="0"
                                IsVisible="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}"
                                Click="OnRemoveClick">
                            <ui:FASymbolIcon Symbol="Delete" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </Setter>
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="ItemContainerTheme">
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="8 0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="ContextFlyout" Value="{StaticResource ComponentsOperationMenuFlyout}"/>
                </ControlTheme>
            </Setter>
            <Style Selector="^ ListBoxItem">
                <Setter Property="(ia:Interaction.Behaviors)">
                    <ia:BehaviorCollectionTemplate>
                        <ia:BehaviorCollection>
                            <behaviors:AdvancedManagedContextDragBehavior HorizontalDragThreshold="3" VerticalDragThreshold="3">
                                <behaviors:AdvancedManagedContextDragBehavior.Context>
                                    <!-- 载荷 =(条目, 所在列表)。$parent[ListBox] 无法参与编译绑定，此处改用反射绑定 -->
                                    <MultiBinding Converter="{x:Static app:PlayerControlDragData.Create}" x:CompileBindings="False">
                                        <Binding/>
                                        <Binding Path="$parent[ListBox].ItemsSource"/>
                                    </MultiBinding>
                                </behaviors:AdvancedManagedContextDragBehavior.Context>
                            </behaviors:AdvancedManagedContextDragBehavior>
                        </ia:BehaviorCollection>
                    </ia:BehaviorCollectionTemplate>
                </Setter>
            </Style>
        </Style>
    </UserControl.Styles>
    <Grid Margin="12 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0 0 0 12">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="#F0F0F0"/>
            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#A8A8B0"/>
        </StackPanel>

        <!-- ROW 1 说明 -->
        <TextBlock Grid.Row="1"
                   Text="控制栏按行显示：拖动行的手柄调整行的上下顺序，行内拖动调整控件的左右顺序，从组件库拖动控件以添加。"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="0 0 0 8"/>

        <!-- ROW 2 控制栏布局：行列表（纵向），每行 = 拖动手柄 + 行内控件横向列表 + 行操作按钮，
             照 ClassIsland-2.0 组件设置页的多行结构。行重排只允许从手柄拖（避免与行内控件拖动打架）。 -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Lines}"
                 Margin="-12 0">
            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="0 4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="(ia:Interaction.Behaviors)">
                        <ia:BehaviorCollectionTemplate>
                            <ia:BehaviorCollection>
                                <behaviors:AdvancedItemDragBehavior Orientation="Vertical"
                                                                   AllowDragFromDragThumbOnly="True"
                                                                   HorizontalDragThreshold="3"
                                                                   VerticalDragThreshold="3"/>
                            </ia:BehaviorCollection>
                        </ia:BehaviorCollectionTemplate>
                    </Setter>
                </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="app:PlayerControlLine">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <controls:TouchDragThumb Grid.Column="0"
                                                 Margin="0 0 4 0"
                                                 VerticalAlignment="Stretch"/>
                        <ListBox Grid.Column="1"
                                 ItemsSource="{Binding Children}"
                                 Classes="component-listBox"
                                 SelectionChanged="SelectorComponents_OnSelectionChanged">
                            <ia:Interaction.Behaviors>
                                <ia:BehaviorCollection>
                                    <dnd:ManagedContextDropBehavior x:CompileBindings="False"
                                                                    Handler="{Binding $parent[pages:ControlBarSettingsPage].ViewModel.DropHandler}"
                                                                    Context="{Binding Children}"/>
                                </ia:BehaviorCollection>
                            </ia:Interaction.Behaviors>
                        </ListBox>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4 0 0 0">
                            <Button ToolTip.Tip="在下方插入一行"
                                    Click="ButtonInsertLineBelow_OnClick"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <ui:FASymbolIcon Symbol="Add" FontSize="14"/>
                            </Button>
                            <Button ToolTip.Tip="删除行"
                                    Foreground="IndianRed"
                                    Click="ButtonRemoveLine_OnClick"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <ui:FASymbolIcon Symbol="Delete" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ROW 3 子组件视图：查看某个容器里的控件（ClassIsland 的“此组件的子组件”面板） -->
        <Border Grid.Row="3"
                CornerRadius="4"
                ClipToBounds="True"
                IsVisible="{Binding IsComponentChildrenViewOpen}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid RowDefinitions="Auto,Auto">
                <Border Grid.Row="0" Padding="8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0 0 0 1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0"
                                ToolTip.Tip="返回上一层级"
                                IsVisible="{Binding CanChildrenNavigateBack}"
                                Click="ButtonNavigateUp_OnClick"
                                Background="Transparent"
                                BorderThickness="0">
                            <ui:FASymbolIcon Symbol="Back" FontSize="14"/>
                        </Button>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4 0">
                            <Run Text="此组件的子组件：" />
                            <Run Text="{Binding CurrentContainer.Title}" FontWeight="SemiBold" />
                        </TextBlock>
                        <Button Grid.Column="2"
                                ToolTip.Tip="关闭"
                                Click="ButtonChildrenViewClose_OnClick"
                                Background="Transparent"
                                BorderThickness="0">
                            <ui:FASymbolIcon Symbol="Cancel" FontSize="14"/>
                        </Button>
                    </Grid>
                </Border>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding CurrentContainerChildren}"
                         Classes="component-listBox"
                         SelectionChanged="SelectorComponents_OnSelectionChanged">
                    <ia:Interaction.Behaviors>
                        <ia:BehaviorCollection>
                            <dnd:ManagedContextDropBehavior Handler="{Binding DropHandler}"
                                                            Context="{Binding CurrentContainerChildren}"/>
                        </ia:BehaviorCollection>
                    </ia:Interaction.Behaviors>
                </ListBox>
            </Grid>
        </Border>

        <!-- ROW 4 组件库 / 组件设置 / 高级设置：与 ClassIsland 原页面同一套标签页结构 -->
        <TabControl Grid.Row="4" Padding="0" Margin="0 16 0 0">
            <TabItem Header="组件库">
                <ScrollViewer Padding="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding Library}"
                             Classes="drag-source"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="app:PlayerControlLibraryEntry">
                                <Grid HorizontalAlignment="Stretch" RowDefinitions="Auto,*" ColumnDefinitions="Auto,Auto,*,Auto"
                                      Margin="0 8" Height="50">
                                    <controls:TouchDragThumb Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                                             Width="24"/>

                                    <ui:FAIconSourceElement Grid.Column="1" Grid.Row="0"
                                                            Grid.RowSpan="2"
                                                            Width="32" Height="32"
                                                            VerticalAlignment="Center"
                                                            ClipToBounds="False"
                                                            Margin="0 -4 4 0"
                                                            IconSource="{Binding IconSource}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{Binding Title}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Margin="0 0 0 1"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               Text="{Binding Description}"
                                               Opacity="0.75"
                                               FontSize="12"
                                               FontWeight="Regular"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Stretch"
                                               TextAlignment="Left"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel>
                                    <ia:Interaction.Behaviors>
                                        <ia:BehaviorCollection>
                                            <behaviors:WrapPanelAutoResizeBehavior TargetWidth="225"/>
                                        </ia:BehaviorCollection>
                                    </ia:Interaction.Behaviors>
                                </WrapPanel>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="组件设置" IsVisible="{Binding IsComponentSettingsVisible}">
                <ContentControl Content="{Binding SelectedItem.Settings}" Margin="0 8 0 0">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="app:SlideControlSettings">
                            <controlSettings:SlideControlSettingsView />
                        </DataTemplate>
                        <DataTemplate DataType="app:RollingControlSettings">
                            <controlSettings:RollingControlSettingsView />
                        </DataTemplate>
                        <DataTemplate DataType="app:SeekStepControlSettings">
                            <controlSettings:SeekStepControlSettingsView />
                        </DataTemplate>
                        <DataTemplate DataType="app:VolumeControlSettings">
                            <controlSettings:VolumeControlSettingsView />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </TabItem>
            <TabItem Header="高级设置" IsVisible="{Binding IsComponentAdvancedSettingsVisible}">
                <ContentControl Content="{Binding SelectedItem}" Margin="0 8 0 0">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="app:PlayerControlItem">
                            <controlSettings:AdvancedSettingsView />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>