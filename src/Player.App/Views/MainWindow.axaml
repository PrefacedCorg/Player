<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Player.App.ViewModels"
        xmlns:pc="clr-namespace:Player.App.Views.PlayerControls"
        xmlns:mpv="clr-namespace:HanumanInstitute.LibMpv.Avalonia;assembly=HanumanInstitute.LibMpv.Avalonia"
        x:Class="Player.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Player · M0 骨架"
        Width="1280"
        Height="800"
        Background="#0F0F13">

  <!-- 布局前提：默认 Native 渲染器下视频是原生子窗口，Avalonia 控件无法叠加在视频之上，
       因此信息与控制一律放在视频区之外的控制条里。
       控件尺寸不再逐控件覆盖，一律走 FluentAvaloniaTheme 的默认度量。 -->
  <Grid RowDefinitions="*,Auto">

    <mpv:MpvView x:Name="VideoView"
                 Grid.Row="0"
                 Renderer="Native"
                 MpvContext="{Binding Mpv}" />

    <Border Grid.Row="1" Background="#1B1B22" IsVisible="{Binding IsControlBarVisible}">
      <!-- 控制行：控件全部组件化（Views/PlayerControls 下一个控件一个文件），行结构照 ClassIsland-2.0
           的主界面多行机制。这里只放宿主，控制栏里有几行、每行放哪些控件、按什么顺序由设置里的
           行列表决定，可在 设置 → 控制栏 里加删行、调整顺序，改完立即重建。
           状态 / 时序 / 调试信息也走组件（调试信息控件），不再写死在主窗口里。 -->
      <pc:PlayerControlBar />
    </Border>
  </Grid>
</Window>