<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Player.App.ViewModels"
             x:Class="Player.App.Views.PlayerControls.PlayerControlBar"
             x:DataType="vm:MainWindowViewModel">

  <!-- 控制栏宿主：控件不写死在这里，而是按设置里的有序列表生成（见 PlayerControlBar.axaml.cs）。
       每个控件是 Views/PlayerControls 下的独立 UserControl，DataContext 由视觉树继承（= 主窗口 VM）。 -->
  <Grid x:Name="Root" ColumnSpacing="16" />
</UserControl>