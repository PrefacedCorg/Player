<?xml version="1.0" encoding="utf-8"?>
<!-- win-x64 发布配置：自包含 + NativeAOT，文件夹形式发布。
     两个刻意的选择：
     1) 不用 PublishSingleFile：单文件会把 libmpv-2.dll 卷进 exe 且运行时不释放，
        LibMpv 加载原生库失败（DllNotFoundException，启动即崩）；首次运行还要解包 216MB，多花约 2.5 秒。
     2) 用 PublishAot 而不是 ReadyToRun：同机实测首帧 519 ms（R2R 为 1237 ms）、
        体积 154 MB（R2R 249 MB）、播放期 CPU 1.5%（R2R 2.9%）。
        前置条件：需安装 MSVC C++ 生成工具（NativeAOT 依赖 link.exe）。
        若后续遇到裁剪引发的运行时异常，去掉 PublishAot、加回 PublishReadyToRun=true 即可退回 R2R。
     用法：dotnet publish src/Player.App/Player.App.csproj -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>