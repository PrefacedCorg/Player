<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:Player.App.ViewModels"
             x:Class="Player.App.Views.SettingsPages.PlaybackSettingsPage"
             x:DataType="vm:PlaybackSettingsViewModel">

  <!-- 播放行为设置页。DataContext 由外层 ContentControl 按 DataType 匹配自动注入（VM-first）。 -->
  <StackPanel Spacing="12">
    <StackPanel Spacing="4" Margin="0,0,0,8">
      <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="#F0F0F0" />
      <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#A8A8B0" />
    </StackPanel>

    <ui:FASettingsExpander Header="记忆上次播放位置"
                           Description="再次打开同一文件时，从上次退出的位置继续">
      <ui:FASettingsExpander.Footer>
        <ToggleSwitch IsChecked="{Binding ResumeLastPosition, Mode=TwoWay}" OnContent="开" OffContent="关" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander Header="播放结束自动连播"
                           Description="队列中还有文件时自动播放下一个">
      <ui:FASettingsExpander.Footer>
        <ToggleSwitch IsChecked="{Binding AutoAdvanceQueue, Mode=TwoWay}" OnContent="开" OffContent="关" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>

    <ui:FASettingsExpander Header="打开文件后的动作"
                           Description="选中文件或拖入文件后的默认行为">
      <ui:FASettingsExpander.Footer>
        <ComboBox ItemsSource="{Binding StartupActions}"
                  SelectedItem="{Binding StartupAction, Mode=TwoWay}" />
      </ui:FASettingsExpander.Footer>
    </ui:FASettingsExpander>
  </StackPanel>
</UserControl>
