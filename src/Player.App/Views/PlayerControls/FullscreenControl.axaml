<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Player.App.ViewModels"
             xmlns:controls="clr-namespace:Player.App.Controls"
             x:Class="Player.App.Views.PlayerControls.FullscreenControl"
             x:DataType="vm:MainWindowViewModel">

  <controls:PlayerControlButton Text="{Binding FullscreenText}" Icon="{x:Static controls:PlayerControlIcons.Fullscreen}" Click="OnClick"
                                Foreground="{DynamicResource PlayerControlForeground}" />
</UserControl>
